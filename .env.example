# Copy to .env and fill in. .env is gitignored.
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend auth: see deploy/AUTH.md. Load explicitly with uvicorn --env-file .env.
APP_ENV=production
AUTH_DEV_ANONYMOUS=false
AUTH0_ISSUER=https://YOUR_TENANT.auth0.com/
AUTH0_AUDIENCE=https://api.anhydra.work
AUTH0_CLAIM_NAMESPACE=https://anhydra.work/claims/
# Inject a real restricted role and trusted CA path through deployment secrets.
DATABASE_URL=postgresql+psycopg://APP_USER:REPLACE_ME@DB_HOST/anhydra?sslmode=verify-full&sslrootcert=/etc/anhydra/db-ca.pem
# Empty for same-origin hosting; otherwise comma-separated exact origins, no trailing slash.
CORS_ORIGINS=
