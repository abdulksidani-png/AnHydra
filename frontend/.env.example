# Copy to .env.local and edit. All are optional.

# Where `npm run dev` proxies /score and /health.
# Point this at the Vultr box to develop against the live model:
#   VITE_PROXY_TARGET=http://64.177.42.245
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Backend origin used by the built app. Leave unset when FastAPI or Caddy
# serves the built files from the same host as the API — which is the plan.
# VITE_API_BASE=

# Set true to work on the UI with fixtures and send no requests at all.
# There is no automatic fallback to fixtures when a request fails: the backend
# returns 503 rather than inventing a score, and the UI respects that.
VITE_USE_MOCK=false

# Sign-in with Auth0 (UI sign-in only; the scoring API is public). Leave VITE_AUTH0_DOMAIN empty to
# run without sign-in. These values are public, not secrets.
# VITE_AUTH0_DOMAIN=anhydra.us.auth0.com
# VITE_AUTH0_CLIENT_ID=
# VITE_AUTH0_AUDIENCE=https://anhydra.work/api
