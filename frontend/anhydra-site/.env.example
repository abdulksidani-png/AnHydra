# Copy to .env.local (development) or .env.production.local (the server's build) and fill in.
# Everything here ends up in the built site and is public. Never put a client secret here.

# Backend that `npm run dev` proxies /score, /health, /me and /ready to.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Sign-in with Auth0. All three are required together; they must match the backend's settings:
#   VITE_AUTH0_DOMAIN    the tenant domain; the backend's AUTH0_ISSUER is https://<this>/
#   VITE_AUTH0_CLIENT_ID the Single Page Application's client ID
#   VITE_AUTH0_AUDIENCE  the API identifier, exactly the backend's AUTH0_AUDIENCE
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Or, with no Auth0 settings at all, run without sign-in. Only for a backend running with
# PUBLIC_ACCESS=true. Setting both this and the Auth0 settings is refused.
# VITE_PUBLIC_ACCESS=true
