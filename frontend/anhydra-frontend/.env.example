# Copy to .env.local and edit.
#
# Everything here is baked into the bundle at build time and is readable by
# anyone who opens the site. These are all public settings. A client secret or
# a Management API credential must NEVER appear in a VITE_ variable.

# Where `npm run dev` proxies /score, /health, /ready and /me.
# Point this at the server to develop against the live backend:
#   VITE_PROXY_TARGET=https://anhydra.work
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Backend origin used by the built app. Leave unset when the same host serves
# the files and the API — which is the deployment plan.
# VITE_API_BASE=

# Development-only scoring/health fixtures. Authenticated mode still calls /me.
# There is no automatic fallback to fixtures when a request fails: the backend
# returns 503 rather than inventing a score, and the UI respects that.
VITE_USE_MOCK=false

# --- Auth0 -------------------------------------------------------------
# Domain, client ID and audience are all REQUIRED for a production build.
# A partial configuration refuses to start rather than quietly serving the
# screener with no sign-in.

VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# Must match backend AUTH0_AUDIENCE, not the SPA client ID.
VITE_AUTH0_AUDIENCE=
# Backend AUTH0_ISSUER must be https://<VITE_AUTH0_DOMAIN>/.
# Configure the access-token-only signed claims documented in AUTH.md.

# Email + password connection. Leave as-is unless the tenant renamed it.
VITE_AUTH0_DB_CONNECTION=Username-Password-Authentication

# Microsoft connection name, exactly as it appears in the tenant. Leave empty
# if there isn't one — the button is then omitted rather than offering a login
# that cannot succeed. Do not guess this name: whether university accounts
# work depends on how the connection was created.
VITE_AUTH0_MICROSOFT_CONNECTION=

# Development escape hatch: run the UI with no sign-in at all.
# Rejected by `npm run build`. The backend must separately enable its dev bypass.
VITE_AUTH0_ALLOW_ANONYMOUS=false
