# React deployment for frontend-auth. Build frontend/anhydra-frontend/dist and copy its contents to
# /var/www/tardiscreen before switching from the FastAPI-only configuration.
@@DOMAIN@@ {
    encode zstd gzip
    @api path /me /score /health /ready /docs /docs/* /redoc /openapi.json
    handle @api {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        root * /var/www/tardiscreen
        try_files {path} /index.html
        file_server
    }
}
